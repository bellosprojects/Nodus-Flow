{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-title",
    "dialog:allow-save",
    "fs:allow-write-file",
    "deep-link:default",
    "dialog:default",
    "store:default"
  ]
}