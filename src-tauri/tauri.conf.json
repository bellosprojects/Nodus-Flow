{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodus Flow",
  "version": "0.0.1",
  "identifier": "com.bellosprojects.nodus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nodus Flow",
        "width": 1024,
        "height": 650,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Bello's Projects",
    "copyright": "Copyright © 2026 Nodus Flow",
    "category": "DeveloperTool",
    "shortDescription": "Editor de diagramas colaborativo en tiempo real",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
